{
  "description": "MACF agent hooks: dependency installer, work check, SessionEnd + PreCompact peer-notification (UC-1 per DR-023; moved off the per-turn Stop hook in macf#673 to stop blocking the TUI every turn — distinguishable session-end vs session-compact events), PreCompact-hook session checkpoint (UC-3 per DR-023), the turn-state marker that lets the channel server report accurate live agent state through long tool waits (DR-030 phase-1, groundnuty/macf#568), and the single-sourced load-bearing guard set (DR-039 Decision 2, groundnuty/macf#731/#739): gh-token attribution-trap (#140), mention-routing-hygiene (#244/#272), LGTM-gate (#270), close-keyword-guard (#431), attribution result-invariant backstop (#489), reflection-harvest (#500), channel-server liveness guard (#734), and the framework-surface git-sweep guard pair (#814): check-framework-surface.sh (SessionStart — detects a swept/missing plugin mount, identity config, or guard-hook set and warns loud to run `macf update`) + check-git-sweep.sh (PreToolUse Bash — blocks `git stash -u`/`--include-untracked`/`-a`/`--all` and `git clean` force+directories combos when the untracked macf framework surface would actually be swept). As of DR-039 phase 2 (groundnuty/macf#698), these scripts live in the plugin (`packages/macf/plugin/scripts/`, joining `mark-turn-state.sh`) and are invoked via ${CLAUDE_PLUGIN_ROOT}/scripts/<name>.sh — tamper-resistant, since an agent can no longer defeat an enforcement hook by editing its workspace `.claude/scripts/` copy. A compat copy is still distributed to `.claude/scripts/` by `macf init`/`update` for hand-wired substrate hooks + non-plugin-init'd workspaces, pending full DR-039 substrate rollout.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "diff -q \"${CLAUDE_PLUGIN_ROOT}/package.json\" \"${CLAUDE_PLUGIN_DATA}/package.json\" >/dev/null 2>&1 || (cd \"${CLAUDE_PLUGIN_DATA}\" && cp \"${CLAUDE_PLUGIN_ROOT}/package.json\" . && npm install) || rm -f \"${CLAUDE_PLUGIN_DATA}/package.json\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Run /macf-status to see your identity and peers, then /macf-issues to check pending work.'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-channel-alive.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-framework-surface.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/mark-turn-state.sh\" user-prompt-submit",
            "async": true,
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-channel-alive.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/mark-turn-state.sh\" pre-tool-use",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-gh-token.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-mention-routing.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-lgtm-gate.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-close-keyword.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-git-sweep.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/mark-turn-state.sh\" post-tool-use",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-gh-attribution.sh\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/mark-turn-state.sh\" post-tool-use-failure",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/mark-turn-state.sh\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/mark-turn-state.sh\" stop-failure",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/mark-turn-state.sh\" session-end",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "macf-agent",
            "tool": "notify_peer",
            "input": {
              "event": "session-end"
            },
            "timeout": 30,
            "statusMessage": "Notifying peers of session end..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "macf-agent",
            "tool": "checkpoint_to_memory",
            "input": {
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}"
            },
            "timeout": 30,
            "statusMessage": "Writing session checkpoint to memory..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "macf-agent",
            "tool": "notify_peer",
            "input": {
              "event": "session-compact"
            },
            "timeout": 30,
            "statusMessage": "Notifying peers of session compaction..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/harvest-reflection.sh\""
          }
        ]
      }
    ]
  }
}
