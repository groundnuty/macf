.claude/settings.local.json
# `.claude/rules/` holds workspace refresh artifacts (written by
# `macf rules refresh`), not source. Canonical rule files live at
# `plugin/rules/`. Without this ignore, the refresh-produced copy
# appears as a persistent untracked file and causes `macf self-update`
# to refuse with a dirty-tree error. Both agents hit this same day
# — see `project_untracked_coordination_artifact.md`.
.claude/rules/
node_modules/
dist/
*.tsbuildinfo
*.log
.env
.env.local
coverage/
.worktrees/
*.pem

# Local CLI/gh state dirs (e.g. packages/*/.local/state/gh/) — never source
.local/

# Local subagent worktrees (never committed)
.claude/worktrees/

# MACF runtime dirs (per-workspace env files, certs, registry, channel-server
# runtime state) generated by `macf init`/`update` — never source. Matches
# `.macf/` at the root and `.claude/.macf/` (any depth). The channel-server
# log cluster itself now lives in the agent HOME (macf#642); this backstops
# the workspace runtime dir from ever being committed.
.macf/
