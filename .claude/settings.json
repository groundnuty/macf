{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "model": "claude-opus-4-7",
  "enableAllProjectMcpServers": false,
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill(macf-agent:macf-status)",
      "Skill(macf-agent:macf-issues)",
      "Skill(macf-agent:macf-peers)",
      "Skill(macf-agent:macf-ping)",
      "Skill(macf-agent:macf-notify-peer)",
      "mcp__macf-agent__notify_peer",
      "mcp__macf-agent__checkpoint_to_memory",
      "mcp__*"
    ],
    "deny": [
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*.pem)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.npmrc)",
      "Edit(~/.pypirc)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.netrc)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.profile)",
      "Edit(~/.bash_profile)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(docker push *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "ssh:*",
      "scp:*",
      "rsync:*",
      "devbox:*",
      "nix:*",
      "git:*",
      "gpg:*",
      "gpg-agent:*",
      "gh:*",
      "npx:*",
      "npm:*",
      "node:*",
      "make:*",
      "tmux:*",
      "jq:*",
      "openssl:*",
      "grep:*",
      "rg:*",
      "find:*",
      "head:*",
      "tail:*",
      "cat:*",
      "ls:*",
      "wc:*",
      "sort:*",
      "awk:*",
      "sed:*",
      "diff:*",
      "which:*",
      "bash:*",
      "sh:*",
      "xargs:*",
      "mkdir:*",
      "cp:*",
      "touch:*"
    ],
    "network": {
      "allowedDomains": [
        "*"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/devbox",
        "~/.local/share/devbox",
        "~/.nix-profile",
        "/nix",
        "/Users/orzech/Dropbox/home/repos/groundnuty/macf-science-agent/paper-research",
        "/home/ubuntu/repos/groundnuty/macf-science-agent/paper-research",
        "/tmp"
      ],
      "denyWrite": [
        "/etc",
        "/usr",
        "/bin",
        "/sbin",
        "~/.ssh",
        "~/.aws",
        "~/.bashrc",
        "~/.zshrc"
      ],
      "denyRead": [
        "~/.aws",
        "~/.kube",
        "~/.config/gcloud"
      ],
      "allowRead": [
        "/proc/self/fd"
      ]
    }
  },
  "statusLine": {
    "type": "command",
    "command": ".claude/scripts/macf-statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "everything-claude-code@everything-claude-code": false,
    "holistic-linting@jamie-bitflight-skills": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/check-auditor-never-acts.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Branch: $(git branch --show-current 2>/dev/null || echo 'detached'). Recent: $(git log --oneline -3 2>/dev/null || echo 'no commits')\"",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Post-compaction reminder: ESM-only TypeScript project (.js import extensions). Use devbox — do not install on host. Makefile (dev.mk) is primary dev interface. Run make -f dev.mk check before finishing.'",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/check-channels-enabled.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/macf-startup-pickup.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v jq >/dev/null 2>&1 || exit 0; FILE=$(cat | jq -r \".tool_input.file_path // empty\"); case \"$FILE\" in *.ts|*.tsx) npx eslint --no-warn-ignored \"$FILE\" 2>&1 | head -20 || true ;; esac'",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "sh -c 'command -v jq >/dev/null 2>&1 || exit 0; FILE=$(cat | jq -r \".tool_input.file_path // empty\"); case \"$FILE\" in *.ts|*.tsx) npx tsc --noEmit 2>&1 | head -20 ;; esac; exit 0'",
            "timeout": 30000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'echo \"State before compaction:\"; echo \"Branch: $(git branch --show-current 2>/dev/null)\"; echo \"Modified files: $(git diff --name-only 2>/dev/null | tr \"\\n\" \", \")\"; echo \"Staged files: $(git diff --cached --name-only 2>/dev/null | tr \"\\n\" \", \")\"'",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'INPUT=$(cat); if echo \"$INPUT\" | jq -e .stop_hook_active >/dev/null 2>&1 && [ \"$(echo \"$INPUT\" | jq -r .stop_hook_active)\" = \"true\" ]; then exit 0; fi; [ -z \"$CLAUDE_PROJECT_DIR\" ] && exit 0; cd \"$CLAUDE_PROJECT_DIR\" || exit 0; [ -f package.json ] || exit 0; command -v devbox >/dev/null 2>&1 || exit 0; CHANGED=$(git status --porcelain 2>/dev/null | grep -iE \"\\.(ts|tsx|mts|cts|js|mjs|cjs)$|package(-lock)?\\.json$|tsconfig[^/]*\\.json$|vitest\\.config\\.|eslint\\.config\\.|\\.eslintrc|dev\\.mk$\"); if [ -z \"$CHANGED\" ]; then echo \"Stop hook: no build-affecting working-tree changes; skipping make check.\"; exit 0; fi; OUTPUT=$(make -f dev.mk check 2>&1); rc=$?; printf \"%s\\n\" \"$OUTPUT\" | tail -30; if [ $rc -ne 0 ]; then exit 2; fi'",
            "timeout": 120000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/emit-turn-receipt.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "macf-agent"
  ]
}
